# /etc/default/hylion-bridge 로 복사해서 사용.
# 코드 수정 없이 systemd 재시작만으로 튜닝 가능.

# === 매핑 (BHL 학습 명령 범위 안에서 보수적으로 시작; 실험 후 조정) ===
BRIDGE_VEL_FORWARD=0.5
BRIDGE_VEL_TURN_LEFT=0.5

# === 통신 ===
BRIDGE_TCP_HOST=0.0.0.0
BRIDGE_TCP_PORT=9000
BRIDGE_UDP_HOST=127.0.0.1
BRIDGE_UDP_PORT=10011

# === 안전/타이밍 ===
BRIDGE_WATCHDOG_S=0.2
BRIDGE_SEND_HZ=20

# === 로그 ===
BRIDGE_LOG_LEVEL=INFO
# BRIDGE_LOG_FILE=/var/log/hylion-bridge.log   # 비우면 journald 로만
